# Birdhouse environment variables
# Copy this file to .env.local and fill in real values.

# Resend API key for sending lead/contact-form emails.
# Get one free at https://resend.com (Dashboard → API Keys).
# If left blank, form submissions are validated and logged to the server
# console instead of emailed — useful for local development.
RESEND_API_KEY=

# The "from" address. Must be a verified domain in Resend.
# During testing you can use Resend's sandbox sender below.
LEAD_FROM_EMAIL="Birdhouse <onboarding@resend.dev>"

# Where lead notifications are delivered.
LEAD_TO_EMAIL="hello@birdhouse.co.in"

# ---------------------------------------------------------------------------
# Admin panel (/admin)
# ---------------------------------------------------------------------------

# The single password used to log into /admin. Set this to something strong.
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. Generate one with:
#   openssl rand -base64 32
# If unset, falls back to ADMIN_PASSWORD (changing the password logs admins out).
SESSION_SECRET=

# Supabase — stores admin-managed content (properties, blogs, site content),
# lead submissions, and uploaded listing photos (in the public "listings"
# Storage bucket). Find these in your Supabase project: Settings → API.
# The service-role key is secret — server-only, never expose it to the browser.
# If unset, the site serves the built-in seed content and admin edits won't save.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# SEO
# ---------------------------------------------------------------------------

# Google Search Console verification token (the content="..." value from the
# HTML-tag verification method). Renders a <meta name="google-site-verification">
# tag site-wide. Leave blank if verifying via DNS instead.
GOOGLE_SITE_VERIFICATION=
